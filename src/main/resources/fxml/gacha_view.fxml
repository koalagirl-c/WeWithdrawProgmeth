<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    gacha_view.fxml - หน้าจอตู้กาชา
    Components:
    - Label      : แสดงผลลัพธ์และข้อมูลต่างๆ
    - Button     : ปุ่ม Roll 1x และ Roll 10x
    - CheckBox   : ปิด/เปิดเสียง
    - Separator  : เส้นแบ่ง
    - VBox/HBox  : Layout
-->

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gachapet.controller.GachaController"
      spacing="16" alignment="TOP_CENTER"
      styleClass="gacha-root">
    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

    <!-- Header -->
    <Label text="🎰 ตู้กาชา Kawaii" styleClass="gacha-title"/>
    <Label fx:id="coinLabel" text="💰 500 เหรียญ" styleClass="gacha-coin-label"/>

    <Separator/>

    <!-- Drop Rate Info -->
    <Label fx:id="dropRateLabel" text="Loading..." styleClass="drop-rate-label"/>

    <Separator/>

    <!-- Roll Buttons -->
    <HBox spacing="16" alignment="CENTER">
        <Button fx:id="rollButton" text="🎲 Roll 1x (100 💰)"
                onAction="#onRollButtonClick"
                styleClass="roll-button" prefWidth="200" prefHeight="50"/>
        <Button fx:id="rollTenButton" text="🌟 Roll 10x (1,000 💰)"
                onAction="#onRollTenButtonClick"
                styleClass="roll-ten-button" prefWidth="200" prefHeight="50"/>
    </HBox>

    <!-- Pity System Note -->
    <Label text="✨ Roll 10x รับประกัน SSR อย่างน้อย 1 ตัว!" styleClass="pity-label"/>

    <Separator/>

    <!-- Result Display -->
    <VBox fx:id="resultContainer" spacing="8" alignment="CENTER"
          styleClass="result-container">
        <Label text="🐾 ผลลัพธ์จะแสดงที่นี่" styleClass="result-placeholder"/>
        <Label fx:id="resultLabel" text="" styleClass="result-label" wrapText="true"/>
        <Label fx:id="resultDetailLabel" text="" styleClass="result-detail-label" wrapText="true"/>
    </VBox>

    <Separator/>

    <!-- Sound Toggle -->
    <CheckBox fx:id="soundCheckBox" text="🔊 เปิดเสียงเอฟเฟกต์"
              styleClass="sound-checkbox-gacha"/>

</VBox>
